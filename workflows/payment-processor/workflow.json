    {
      "parameters": {
        "jsCode": "const memberName = $input.item.json.memberName;\nconst newDueDate = $input.item.json.newDueDate;\n\nconst response = await this.helpers.httpRequest({\n  method: 'GET',\n  url: 'https://dashboard.fondoruso.ru/api/v1/db/data/noco/YOUR_NOCODB_PROJECT_ID/YOUR_NOCODB_MEMBERS_TABLE_ID',\n  qs: { where: `(Name,eq,${memberName})` },\n  headers: { 'xc-token': 'YOUR_NOCODB_API_TOKEN' }\n});\n\nconst member = response.list[0];\nconst payload = { 'Взнос': newDueDate };\n\nconst status = Array.isArray(member['Статус']) ? member['Статус'][0] : member['Статус'];\nif (status === 'Заявка') {\n  payload['Статус'] = 'FR';\n  payload['Дата вступления'] = '2026-08-01';\n}\n\nreturn [{ json: { memberId: member.Id, payload } }];"
      },

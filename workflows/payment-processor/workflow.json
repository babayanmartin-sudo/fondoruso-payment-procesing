        "url": "=https://dashboard.fondoruso.ru/api/v1/db/data/noco/YOUR_NOCODB_PROJECT_ID/YOUR_NOCODB_TABLE_ID?where=(Name,eq,{{ encodeURIComponent($json.memberName) }})",
        "sendHeaders": true,

{
  "name": "Fondo Ruso: Payments Summary",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "weeks",
              "weeksInterval": 1,
              "triggerAtDay": [1],
              "triggerAtHour": 9
            }
          ]
        }
      },
      "id": "a1b2c3d4-e5f6-7890-abcd-ef1234567890",
      "name": "Weekly Trigger",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [0, 0]
    },
    {
      "parameters": {
        "url": "https://dashboard.fondoruso.ru/api/v1/db/data/noco/YOUR_NOCODB_PROJECT_ID/YOUR_NOCODB_PAYMENTS_TABLE_ID",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "where",
              "value": "(ck0jfgt6xcunro2,ne,1)~or(ck0jfgt6xcunro2,blank,)"
            },
            {
              "name": "limit",
              "value": "1000"
            }
          ]
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "xc-token",
              "value": "YOUR_NOCODB_API_TOKEN"
            }
          ]
        },
        "options": {}
      },
      "id": "b2c3d4e5-f6a7-8901-bcde-f12345678901",
      "name": "Fetch Unprocessed Payments",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [220, 0]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 1
          },
          "conditions": [
            {
              "id": "has-records",
              "leftValue": "={{ $json.list.length }}",
              "rightValue": 0,
              "operator": {
                "type": "number",
                "operation": "gt"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "c3d4e5f6-a7b8-9012-cdef-123456789012",
      "name": "Has Records?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [440, 0]
    },
    {
      "parameters": {
        "jsCode": "const rows = $input.all().map(item => item.json);\n\nfunction csvCell(value) {\n  if (value === null || value === undefined || value === '') return '';\n  const str = String(value);\n  if (/[;\\n\\r\"]/.test(str)) {\n    return '\"' + str.replace(/\"/g, '\"\"') + '\"';\n  }\n  return str;\n}\n\nfunction extractSum(field) {\n  if (!field) return null;\n  const match = String(field).match(/\\b(1800|2500|3600|5000)\\b/);\n  return match ? parseInt(match[0]) : null;\n}\n\nconst now = new Date();\nconst pad = n => String(n).padStart(2, '0');\nconst currentDate =\n  now.getFullYear() + '-' +\n  pad(now.getMonth() + 1) + '-' +\n  pad(now.getDate()) + ' ' +\n  pad(now.getHours()) + ':' +\n  pad(now.getMinutes()) + ':' +\n  pad(now.getSeconds());\n\nconst recordIds = [];\nconst csvLines = [];\n\nfor (const row of rows) {\n  const sum = extractSum(row['Payment']);\n  if (sum === null) continue;\n\n  const comment = row['Name'] || '';\n  const line = sum + ';;Взносы;;' + currentDate + ';' + csvCell(comment) + ';';\n  csvLines.push(line);\n  recordIds.push(row.Id);\n}\n\nconst csvContent = csvLines.join('\\n');\nconst bom = Buffer.from([0xEF, 0xBB, 0xBF]);\nconst csvBuffer = Buffer.concat([bom, Buffer.from(csvContent, 'utf8')]);\n\nreturn [{\n  json: {\n    recordIds,\n    rowCount: recordIds.length\n  },\n  binary: {\n    attachment: {\n      data: csvBuffer.toString('base64'),\n      mimeType: 'text/csv',\n      fileName: 'payments_summary.csv',\n      fileExtension: 'csv'\n    }\n  }\n}];"
      },
      "id": "d4e5f6a7-b8c9-0123-def0-234567890123",
      "name": "Build CSV",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [660, 0]
    },
    {
      "parameters": {
        "fromEmail": "noreply@fondoruso.ru",
        "toEmail": "YOUR_ALERT_EMAIL",
        "subject": "=Fondo Ruso: Payments Summary ({{ $json.rowCount }} записей)",
        "html": "=Добрый день,<br><br>Во вложении файл выгрузки платежей для импорта.<br><br>Количество записей: {{ $json.rowCount }}<br><br>---<br>Автоматическое письмо",
        "options": {
          "attachments": "attachment"
        }
      },
      "id": "e5f6a7b8-c9d0-1234-ef01-345678901234",
      "name": "Send CSV by Email",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [880, 0],
      "credentials": {
        "smtp": {
          "id": "YOUR_SMTP_CREDENTIAL_ID",
          "name": "SMTP - Fondo Ruso"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const recordIds = $('Build CSV').first().json.recordIds;\nreturn recordIds.map(id => ({ json: { recordId: id } }));"
      },
      "id": "f6a7b8c9-d0e1-2345-f012-456789012345",
      "name": "Expand Record IDs",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1100, 0]
    },
    {
      "parameters": {
        "method": "PATCH",
        "url": "=https://dashboard.fondoruso.ru/api/v1/db/data/noco/YOUR_NOCODB_PROJECT_ID/YOUR_NOCODB_PAYMENTS_TABLE_ID/{{ $json.recordId }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "xc-token",
              "value": "YOUR_NOCODB_API_TOKEN"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "application/json",
        "body": "={{ JSON.stringify({ 'ck0jfgt6xcunro2': 1 }) }}",
        "options": {}
      },
      "id": "a7b8c9d0-e1f2-3456-0123-567890123456",
      "name": "Mark as Sent",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1320, 0]
    }
  ],
  "pinData": {},
